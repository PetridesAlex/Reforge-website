# Public site URL used for canonical tags, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=

# Store listings. Play uses the live Android package. Replace the App Store URL with the numeric Apple ID URL once listed.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Supabase — anon key is safe for the browser. Never expose the service role key to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — server-only. Never expose this key to the browser.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
